# Port the API listens on
PORT=3000
# SQLite file (directory is created automatically)
DATABASE_PATH=./data/baskt.db
# Shared bearer token the Android app sends as "Authorization: Bearer ..."
APP_API_TOKEN=change-me

# OpenAI-compatible chat-completions provider. Groq (free tier: 1000 requests/day, 8000 tokens/minute):
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=openai/gpt-oss-20b
AI_REASONING=low
# More providers: one line each in AI_2 ... AI_9, written as "endpoint, key, model, priority". Fields are
# recognised by their shape, so leave out what stays the same as the provider above. A second key for the
# same free tier doubles the quota:
#AI_2=gsk_the_other_key
# AI_PRIORITY (default 1) picks the order: 1 is tried first, equal numbers are used round-robin, and a
# provider that fails or is rate-limited is skipped until it recovers. A paid fallback behind the free keys:
#AI_3=https://openrouter.ai/api/v1, sk-or-..., openai/gpt-oss-20b, 2
# Fields can also be named — key=, model=, url=, priority=, reasoning= — which is the only way to set
# OpenRouter's provider routing (ignored elsewhere; these lists use "|" because commas separate fields):
#AI_4=order=coreweave, quant=fp4
# The first provider can be a line too (AI_1=...) instead of the three variables above.

# Receipt photos need a vision model; Groq has none, so point these at another provider (e.g. Hack Club / OpenRouter).
# AI_VISION_2 ... AI_VISION_9 add more of them, in the same one-line form as AI_2.
AI_VISION_BASE_URL=https://ai.hackclub.com/proxy/v1
AI_VISION_API_KEY=
AI_VISION_MODEL=google/gemini-2.5-flash-lite

# Dictation: recordings are transcribed on the server and the phone's own recogniser only takes over when
# it is offline or nothing here answers. With Groq above this needs nothing — the same key serves Whisper,
# so every Groq provider joins this pool. AI_STT=off keeps dictation on the phone.
#AI_STT=off
# The model for whichever providers end up in the pool (whisper-large-v3-turbo is faster, a little rougher):
#AI_STT_MODEL=whisper-large-v3
# A key or endpoint of its own replaces the inherited providers, e.g. Whisper on Groq while the chat models
# live elsewhere. AI_STT_1 is the same one-line form as AI_2; AI_STT_2 ... add more of them.
#AI_STT_1=https://api.groq.com/openai/v1, gsk_..., whisper-large-v3
#AI_STT_2=gsk_second_key

# Optional separate pool for the assistant's tool-using turns (~2k tokens per step, too much for Groq's
# free 8k tokens/minute). Set any AI_ASSISTANT_* value to enable it (AI_ASSISTANT_2 for a second one);
# the values it does not set default to the main ones.
#AI_ASSISTANT_BASE_URL=https://ai.hackclub.com/proxy/v1
#AI_ASSISTANT_API_KEY=
#AI_ASSISTANT_MODEL=openai/gpt-oss-20b
#AI_ASSISTANT_REASONING=low
#AI_ASSISTANT_PROVIDER_ORDER=coreweave
#AI_ASSISTANT_PROVIDER_QUANTIZATIONS=fp4
#AI_ASSISTANT_2=sk-or-..., 2

# Optional HTTP(S) proxy used only for supermarket requests (e.g. a VPN sidecar)
STORE_PROXY_URL=
# Minimum gap between requests to the same store, in ms
STORE_MIN_GAP_MS=400
# Search cache TTL in hours
SEARCH_CACHE_TTL_HOURS=24
# WhatsApp bridge (see backend/whatsapp/README.md); leave empty to hide the feature
WHATSAPP_URL=
# Nightly price scan of products in your baskets (local time, HH:MM); PRICE_SCAN=off disables it
PRICE_SCAN=on
PRICE_SCAN_TIME=03:30

# Optional multilingual speech replies through the Hack Club Replicate proxy.
REPLICATE_API_TOKEN=
