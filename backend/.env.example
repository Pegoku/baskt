# Port the API listens on
PORT=3000
# SQLite file (directory is created automatically)
DATABASE_PATH=./data/baskt.db
# Shared bearer token the Android app sends as "Authorization: Bearer ..."
APP_API_TOKEN=change-me

# OpenAI-compatible chat-completions provider (Hack Club AI works)
AI_BASE_URL=https://ai.hackclub.com/proxy/v1
AI_API_KEY=
AI_MODEL=qwen/qwen3-32b
# Send `reasoning: {enabled: false}` (OpenRouter-style) so thinking models answer directly. Set to false for providers that reject it.
AI_DISABLE_REASONING=true

# Optional HTTP(S) proxy used only for supermarket requests (e.g. a VPN sidecar)
STORE_PROXY_URL=
# Minimum gap between requests to the same store, in ms
STORE_MIN_GAP_MS=400
# Search cache TTL in hours
SEARCH_CACHE_TTL_HOURS=24
